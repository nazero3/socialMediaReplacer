generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  tech
  news
  diy
  til
}

enum SourceKind {
  REDDIT
  HN
  WIKI
  RSS
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ArticleKind {
  DIGEST
  FEATURE
}

enum DigestStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Source {
  id          String     @id @default(cuid())
  kind        SourceKind
  externalId  String
  url         String
  urlHash     String     @unique
  title       String
  author      String?
  publishedAt DateTime?
  fetchedAt   DateTime   @default(now())
  category    Category
  payload     Json
  language    String     @default("en")

  citations ArticleSource[]

  @@index([category, publishedAt])
  @@index([kind, fetchedAt])
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  bodyMarkdown   String
  heroImageUrl   String?
  category       Category
  status         ArticleStatus @default(PUBLISHED)
  kind           ArticleKind   @default(DIGEST)
  readingTimeSec Int           @default(60)
  publishedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sources    ArticleSource[]
  tags       ArticleTag[]
  digestRun  DigestRun?

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
}

model ArticleSource {
  articleId String
  sourceId  String
  position  Int

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([articleId, sourceId])
  @@index([articleId, position])
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model IngestRun {
  id            String     @id @default(cuid())
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  sourceKind    SourceKind
  itemsFetched  Int        @default(0)
  itemsNew      Int        @default(0)
  error         String?

  @@index([sourceKind, startedAt])
}

model DigestRun {
  id        String       @id @default(cuid())
  runDate   DateTime     @db.Date
  category  Category
  status    DigestStatus @default(RUNNING)
  error     String?
  articleId String?      @unique

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([runDate, category])
  @@index([status, runDate])
}
