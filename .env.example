# Database
DATABASE_URL="postgresql://smr:smr@localhost:5433/smr?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6380"

# API
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin auth (token compared in timing-safe fashion)
ADMIN_TOKEN="change-me-in-production"

# Reddit (per Reddit API ToS, a descriptive User-Agent is required)
REDDIT_USER_AGENT="socialMediaReplacer/0.1 (+https://example.com)"

# LLM
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_API_KEY=""
# OLLAMA_URL="http://localhost:11434"

# Worker scheduling
INGEST_CRON="0 */6 * * *"
DIGEST_CRON="0 6 * * *"
INGEST_LIMIT_PER_SOURCE=20

# Logging
LOG_LEVEL="info"
