# Database (local docker-compose maps Postgres to 5433)
DATABASE_URL="postgresql://smr:smr@localhost:5433/smr?schema=public"

# Prisma direct connection URL (required by apps/api/prisma/schema.prisma `directUrl`)
# For local dev, pointing DIRECT_URL at the same DB is fine.
DIRECT_URL="postgresql://smr:smr@localhost:5433/smr?schema=public"

# --- Supabase (copy into `.env` at repo root; never commit real passwords) ---
# Prisma schema lives in apps/api/prisma/. Use the strings from Supabase → Settings → Database → ORM / Prisma.
# Replace [YOUR-PASSWORD], project ref, and region with your project values.
#
# Connect via connection pooling (use for DATABASE_URL everywhere, including GitHub Actions):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Session mode on the pooler host (use for DIRECT_URL — migrations and Prisma `directUrl`):
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis (local docker-compose maps Redis to 6380)
REDIS_URL="redis://localhost:6380"

# API
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin auth (token compared in timing-safe fashion)
ADMIN_TOKEN="change-me-in-production"

# Reddit (per Reddit API ToS, a descriptive User-Agent is required)
REDDIT_USER_AGENT="socialMediaReplacer/0.1 (+https://example.com)"

# LLM
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_API_KEY=""
# OLLAMA_URL="http://localhost:11434"

# Worker scheduling (only used if you run the long-lived BullMQ worker locally)
INGEST_CRON="0 */6 * * *"
DIGEST_CRON="0 6 * * *"
INGEST_LIMIT_PER_SOURCE=20

# If you use GitHub Actions instead of a 24/7 worker, set this in CI (not usually needed locally)
DISABLE_BULLMQ_SCHEDULER=""

# Logging
LOG_LEVEL="info"
